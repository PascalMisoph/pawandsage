---
import ResponsiveImage from './ResponsiveImage.astro';

export interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  readTime?: string;
  image?: string;
  imageAlt?: string;
}

const { href, title, description, category, pubDate, readTime, image, imageAlt = '' } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryLabels = {
  behavior: 'Behavior',
  enrichment: 'Enrichment',
  'new-cat': 'New Cat',
  seasonal: 'Seasonal Care',
};
---

<a href={href} class="post-card">
  {image && (
    <div class="post-card-image">
      <ResponsiveImage
        src={image}
        alt={imageAlt}
        sizes="(min-width: 901px) 350px, (min-width: 601px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        pictureClass="post-card-picture"
        imgClass="post-card-media"
      />
    </div>
  )}
  {!image && (
    <div class={`post-card-image post-card-fallback post-card-fallback--${category}`} aria-hidden="true">
      <span class="post-card-fallback-mark">Paw &amp; Sage</span>
      <span class="post-card-fallback-label">{categoryLabels[category] ?? category}</span>
    </div>
  )}
  <div class="post-card-content">
    <span class="eyebrow post-card-category">{categoryLabels[category] ?? category}</span>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-desc">{description}</p>
    <div class="post-card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {readTime && <span>· {readTime}</span>}
    </div>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--cream-100);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: all 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    color: var(--ink);
  }
  .post-card-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sage-50);
  }
  .post-card-image :global(.post-card-picture) {
    width: 100%;
    height: 100%;
  }
  .post-card-image :global(.post-card-media) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .post-card-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background:
      radial-gradient(circle at 25% 20%, rgba(255, 255, 255, 0.55), transparent 45%),
      radial-gradient(circle at 80% 85%, rgba(224, 160, 133, 0.28), transparent 50%),
      linear-gradient(135deg, var(--sage-50) 0%, var(--cream-200) 100%);
    color: var(--sage-700);
    text-align: center;
  }
  .post-card-fallback--seasonal {
    background:
      radial-gradient(circle at 25% 20%, rgba(255, 255, 255, 0.55), transparent 45%),
      radial-gradient(circle at 80% 85%, rgba(184, 197, 177, 0.4), transparent 50%),
      linear-gradient(135deg, #f6efe3 0%, rgba(224, 160, 133, 0.35) 100%);
  }
  .post-card-fallback-mark {
    font-family: 'Fraunces Variable', 'Fraunces', serif;
    font-style: italic;
    font-size: 1.6rem;
    color: var(--sage-900);
  }
  .post-card-fallback-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .post-card-content {
    padding: 1.5rem;
  }
  .post-card-category {
    display: block;
    margin-bottom: 0.5rem;
  }
  .post-card-title {
    font-family: 'Fraunces Variable', 'Fraunces', serif;
    font-size: 1.25rem;
    color: var(--sage-900);
    margin: 0 0 0.5rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .post-card-desc {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .post-card-meta {
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
</style>

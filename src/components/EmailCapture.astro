---
export interface Props {
  variant?: 'inline' | 'box';
  title?: string;
  description?: string;
  buttonLabel?: string;
  /** Where the form sits, for Umami newsletter-signup events (defaults from the URL). */
  location?: string;
}

// MailerLite form (double opt-in). PUBLIC_MAILERLITE_FORM_URL can override it per environment.
const DEFAULT_FORM_URL = 'https://assets.mailerlite.com/jsonp/2761013/forms/202974784428967520/subscribe';

const {
  variant = 'box',
  title = 'Get our free indoor cat enrichment checklist',
  description = 'Plus seasonal picks and deals worth knowing about. No spam, unsubscribe anytime.',
  buttonLabel = 'Send it to me',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const location =
  Astro.props.location ??
  (path === '/' ? 'homepage' : path.startsWith('/blog/') ? `article:${path.slice(6)}` : `page:${path.slice(1)}`);
const formAction = import.meta.env.PUBLIC_MAILERLITE_FORM_URL || DEFAULT_FORM_URL;
const inputId = `email-capture-${variant}-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class={`email-capture email-capture-${variant}`}>
  <div class="email-capture-content">
    <span class="eyebrow">Free checklist</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <form
      action={formAction}
      method="post"
      target="_blank"
      class="email-form"
      data-mailerlite-form
      data-location={location}
    >
      <label class="sr-only" for={inputId}>Email address</label>
      <input
        id={inputId}
        type="email"
        name="fields[email]"
        placeholder="your@email.com"
        required
        autocomplete="email"
      />
      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />
      <button
        type="submit"
        class="btn btn-accent"
        data-umami-event="newsletter-signup"
        data-umami-event-location={location}
      >{buttonLabel}</button>
    </form>
    <p class="email-status" role="status" aria-live="polite" hidden></p>
    <p class="email-fineprint">
      By subscribing you agree to receive emails from Paw &amp; Sage. Double opt-in, unsubscribe anytime. See our <a href="/privacy">privacy policy</a>.
    </p>
  </div>
</div>

<script>
  const SUCCESS_MESSAGE = 'Check your inbox to confirm your subscription.';

  document.querySelectorAll<HTMLFormElement>('form[data-mailerlite-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      if (!window.fetch || form.dataset.fallback === 'true') return;
      event.preventDefault();

      const status = form.parentElement?.querySelector<HTMLElement>('.email-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const showStatus = (message: string, isError = false) => {
        if (!status) return;
        status.textContent = message;
        status.hidden = false;
        status.classList.toggle('is-error', isError);
      };

      if (button) button.disabled = true;
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => body.append(key, String(value)));

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body,
          headers: { Accept: 'application/json' },
        });
        const data = await response.json().catch(() => null);
        if (response.ok && (!data || data.success)) {
          (window as any).umami?.track?.('newsletter-signup-success', { location: form.dataset.location ?? '' });
          form.hidden = true;
          showStatus(SUCCESS_MESSAGE);
          return;
        }
        const fieldError = data?.errors?.fields?.email?.[0];
        showStatus(fieldError || 'That did not work. Please check the email address and try again.', true);
      } catch {
        // Network or CORS problem: fall back to a normal form POST in a new tab.
        form.dataset.fallback = 'true';
        form.submit();
        showStatus(SUCCESS_MESSAGE);
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

<style>
  .email-capture {
    margin: 3rem 0;
  }
  .email-capture-box .email-capture-content {
    background: var(--sage-50);
    border: 1px solid var(--sage-300);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    text-align: center;
  }
  .email-capture-inline {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 2.5rem 0;
  }
  .email-capture h3 {
    font-size: 1.75rem;
    margin: 0.75rem 0 0.5rem;
    color: var(--sage-900);
  }
  .email-capture p {
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .email-form {
    display: flex;
    gap: 0.5rem;
    max-width: 480px;
    margin: 0 auto 0.75rem;
  }
  .email-form input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    background: var(--cream-100);
    border-radius: 100px;
    font-family: 'Inter Variable', 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .email-form input:focus {
    border-color: var(--sage-700);
  }
  .email-status {
    font-weight: 600;
    color: var(--sage-900);
  }
  .email-status.is-error {
    color: var(--terra-700);
  }
  .email-fineprint {
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 600px) {
    .email-form {
      flex-direction: column;
    }
  }
</style>

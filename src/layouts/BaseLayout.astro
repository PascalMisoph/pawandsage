---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/full-italic.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getShareImage } from '../lib/images';
import { DEFAULT_SOCIAL_IMAGE, ORGANIZATION, PERSON, SITE_DESCRIPTION, SITE_LANGUAGE, SITE_LOGO, SITE_NAME, SITE_URL } from '../lib/site';
import { buildBreadcrumbSchema, type BreadcrumbItem } from '../lib/schema';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  breadcrumbs?: BreadcrumbItem[];
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  resourceHints?: Array<{
    rel: string;
    href: string;
    as?: string;
    type?: string;
    imagesrcset?: string;
    imagesizes?: string;
    crossorigin?: string;
  }>;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_SOCIAL_IMAGE,
  imageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  breadcrumbs = [],
  schema = [],
  resourceHints = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
// Keep <title> within 60 characters for SERPs: append the brand suffix only when it fits.
const MAX_TITLE_LENGTH = 60;
const suffixedTitle = `${title} | ${SITE_NAME}`;
const fullTitle = title === SITE_NAME || suffixedTitle.length > MAX_TITLE_LENGTH ? title : suffixedTitle;
if (fullTitle.length > MAX_TITLE_LENGTH) {
  console.warn(`[seo] <title> longer than ${MAX_TITLE_LENGTH} chars on ${Astro.url.pathname}: "${fullTitle}"`);
}
const shareImage = getShareImage(image);
const socialImage = new URL(shareImage.src, Astro.site ?? SITE_URL).toString();
const socialImageMeta = shareImage.width && shareImage.height ? shareImage : null;
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const schemas = breadcrumbs.length > 0 ? [...pageSchemas, buildBreadcrumbSchema(breadcrumbs)] : pageSchemas;
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const siteSchemas = [
  {
    '@context': 'https://schema.org',
    '@id': `${SITE_URL}#organization`,
    '@type': 'Organization',
    name: ORGANIZATION.name,
    legalName: ORGANIZATION.legalName,
    url: ORGANIZATION.url,
    email: ORGANIZATION.email,
    logo: {
      '@type': 'ImageObject',
      url: ORGANIZATION.logo,
    },
    sameAs: ORGANIZATION.sameAs,
    publishingPrinciples: ORGANIZATION.publishingPrinciples,
    founder: {
      '@type': 'Person',
      name: PERSON.name,
      url: PERSON.url,
    },
  },
  {
    '@context': 'https://schema.org',
    '@id': `${PERSON.url}#person`,
    '@type': 'Person',
    name: PERSON.name,
    givenName: PERSON.givenName,
    familyName: PERSON.familyName,
    url: PERSON.url,
    jobTitle: PERSON.jobTitle,
    description: PERSON.description,
    worksFor: {
      '@type': 'Organization',
      name: ORGANIZATION.name,
      url: ORGANIZATION.url,
    },
  },
  {
    '@context': 'https://schema.org',
    '@id': `${SITE_URL}#website`,
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    inLanguage: SITE_LANGUAGE,
    creator: {
      '@type': 'Person',
      name: PERSON.name,
      url: PERSON.url,
    },
    publisher: {
      '@type': 'Organization',
      name: ORGANIZATION.name,
      url: ORGANIZATION.url,
    },
    publishingPrinciples: ORGANIZATION.publishingPrinciples,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta name='impact-site-verification' value='e41be454-7726-4afb-80ba-b30f12435379'>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="vojFvLUW3NcjO5FdjCejc-0X-g6SbuJtPVZ-RXw-3kQ" />
    <meta name="ahrefs-site-verification" content="a1d136da9b21225796f7b0bd26c52ee9f410b80c8f4573f1cbf8ee982a21655c" />
    <!-- Google Analytics 4. Consent Mode v2: analytics cookies off by default for EEA/UK/CH visitors (cookieless pings only); ad storage always denied. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH']
      });
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'granted'
      });
      gtag('js', new Date());
      gtag('config', 'G-DSMFYSN9P6', { anonymize_ip: true });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DSMFYSN9P6"></script>
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="8c9f1838-9f01-4fe0-ad14-077443c97ca5" data-domains="www.pawandsage.com"></script>
    <meta name="author" content={PERSON.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {resourceHints.map((hint) => <link {...hint} />)}
    <meta name="robots" content={robotsContent} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {socialImageMeta && <meta property="og:image:width" content={String(socialImageMeta.width)} />}
    {socialImageMeta && <meta property="og:image:height" content={String(socialImageMeta.height)} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="pinterest-rich-pin" content="true" />
    <meta name="p:domain_verify" content="314871b4371c8fe024738a356a2a84ce" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <link rel="sitemap" href="/sitemap.xml" />

    {siteSchemas.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    {schemas.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
